{
  "name": "stockpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:services": "tsx services/start-all.ts",
    "dev:gateway": "tsx services/api-gateway/src/server.ts",
    "dev:catalog": "tsx services/catalog-service/src/server.ts",
    "dev:inventory": "tsx services/inventory-service/src/server.ts",
    "dev:expiry": "tsx services/expiry-worker/src/worker.ts",
    "dev:realtime": "tsx services/realtime-service/src/server.ts",
    "dev:all": "concurrently \"tsx services/start-all.ts\" \"next dev --turbopack\"",
    "test:services": "tsx scripts/test-microservices.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.16.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
